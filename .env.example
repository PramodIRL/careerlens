# --- PostgreSQL (docker-compose + apps/api) ---
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=careerlens
# Host apps/api connects to. "localhost" because the API runs on the host,
# not inside Docker, and Postgres's container port is published there.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Convenience DSN for manual psql/tooling access only. apps/api builds its
# own async SQLAlchemy DSN from the POSTGRES_* variables above (app/settings.py),
# it does not read this line.
DATABASE_URL=postgresql://careerlens:changeme@localhost:5432/careerlens

# --- Redis (docker-compose + apps/api) ---
REDIS_PORT=6379
# Celery broker for resume text extraction (Prompt 2.2) — see
# apps/api/app/worker.py. No Celery result backend is configured;
# Postgres (the resumes row itself) is the only source of truth for
# extraction job state.
REDIS_URL=redis://localhost:6379/0

# --- API (apps/api) ---
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# Read by scripts/smoke.sh to override the API's port if 8000 is busy.
API_PORT=8000

# --- Auth (apps/api) ---
# Signs access JWTs. This default is an obvious local-dev-only
# placeholder — every real deployment must set its own.
JWT_SECRET=insecure-dev-secret-change-me-before-deploying
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Shared budget across register/login/refresh, per client IP.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# How long a just-rotated refresh token is tolerated if presented again
# by the immediate predecessor of the current session (a benign
# concurrent-refresh race — two rapid page reloads, or two tabs).
# Anything older, or outside this window, still revokes the session.
# Keep small: bigger values improve UX for slow/laggy races but widen
# the window a stolen freshly-rotated-away token could still be reused.
AUTH_REFRESH_REUSE_GRACE_SECONDS=5

# --- Resume storage (apps/api, Prompt 2.1) ---
# Local filesystem directory uploaded resumes are written to in
# development, relative to apps/api (not committed — see .gitignore).
# A future S3-compatible backend replaces this without changing resume
# domain code (see apps/api/app/storage/).
RESUME_STORAGE_DIR=var/resumes
# Maximum accepted resume file size, in bytes. Default: 5 MiB.
RESUME_MAX_SIZE_BYTES=5242880

# --- Resume text extraction (apps/api, Prompt 2.2) ---
# How many times a *transient* extraction failure (e.g. a storage read
# error) is retried via Celery before the job is marked permanently
# failed. Does not apply to permanent failures — a malformed document
# fails identically every time, so retrying it never helps.
RESUME_EXTRACTION_MAX_RETRIES=2

# --- Public GitHub connection (apps/api, Prompt 3.1) ---
# THERE IS NO GITHUB CREDENTIAL IN THIS PRODUCT AND THERE IS NO VARIABLE
# NAME BELOW FOR ONE. The GitHub connection reads only unauthenticated,
# public endpoints: no password is ever requested, no OAuth token or
# personal access token is ever issued, stored or sent, and no private
# repository is ever accessed.
#
# Base URL for GitHub's public REST API. Override only to point at a
# GitHub Enterprise instance or a local stub.
GITHUB_API_BASE_URL=https://api.github.com
# Total budget for one GitHub request, in seconds. A user is waiting on
# a form submit while this runs, so keep it short.
GITHUB_REQUEST_TIMEOUT_SECONDS=5.0
# GitHub rejects API requests that send no User-Agent. Identifies the
# application, never a user, and carries no credential.
GITHUB_USER_AGENT=CareerLens/0.1 (+https://github.com/careerlens)

# --- Web (apps/web) ---
# Base URL the browser uses to reach the API.
# Next.js only reads this from apps/web/.env.local, not this root file —
# copy the line there too if you need a non-default value.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Read by scripts/smoke.sh to override the web app's port if 3000 is busy.
WEB_PORT=3000
