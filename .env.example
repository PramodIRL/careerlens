# --- PostgreSQL (docker-compose + apps/api) ---
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=careerlens
# Host apps/api connects to. "localhost" because the API runs on the host,
# not inside Docker, and Postgres's container port is published there.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Convenience DSN for manual psql/tooling access only. apps/api builds its
# own async SQLAlchemy DSN from the POSTGRES_* variables above (app/settings.py),
# it does not read this line.
DATABASE_URL=postgresql://careerlens:changeme@localhost:5432/careerlens

# --- Redis (docker-compose + apps/api) ---
REDIS_PORT=6379
# Celery broker for resume text extraction (Prompt 2.2) — see
# apps/api/app/worker.py. No Celery result backend is configured;
# Postgres (the resumes row itself) is the only source of truth for
# extraction job state.
REDIS_URL=redis://localhost:6379/0

# --- API (apps/api) ---
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# Read by scripts/smoke.sh to override the API's port if 8000 is busy.
API_PORT=8000

# --- Auth (apps/api) ---
# Signs access JWTs. This default is an obvious local-dev-only
# placeholder — every real deployment must set its own.
JWT_SECRET=insecure-dev-secret-change-me-before-deploying
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Shared budget across register/login/refresh, per client IP.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# How long a just-rotated refresh token is tolerated if presented again
# by the immediate predecessor of the current session (a benign
# concurrent-refresh race — two rapid page reloads, or two tabs).
# Anything older, or outside this window, still revokes the session.
# Keep small: bigger values improve UX for slow/laggy races but widen
# the window a stolen freshly-rotated-away token could still be reused.
AUTH_REFRESH_REUSE_GRACE_SECONDS=5

# --- Resume storage (apps/api, Prompt 2.1) ---
# Local filesystem directory uploaded resumes are written to in
# development, relative to apps/api (not committed — see .gitignore).
# A future S3-compatible backend replaces this without changing resume
# domain code (see apps/api/app/storage/).
RESUME_STORAGE_DIR=var/resumes
# Maximum accepted resume file size, in bytes. Default: 5 MiB.
RESUME_MAX_SIZE_BYTES=5242880

# --- Resume text extraction (apps/api, Prompt 2.2) ---
# How many times a *transient* extraction failure (e.g. a storage read
# error) is retried via Celery before the job is marked permanently
# failed. Does not apply to permanent failures — a malformed document
# fails identically every time, so retrying it never helps.
RESUME_EXTRACTION_MAX_RETRIES=2

# --- Public GitHub connection (apps/api, Prompt 3.1) ---
# THERE IS NO GITHUB CREDENTIAL IN THIS PRODUCT AND THERE IS NO VARIABLE
# NAME BELOW FOR ONE. The GitHub connection reads only unauthenticated,
# public endpoints: no password is ever requested, no OAuth token or
# personal access token is ever issued, stored or sent, and no private
# repository is ever accessed.
#
# Base URL for GitHub's public REST API. Override only to point at a
# GitHub Enterprise instance or a local stub.
GITHUB_API_BASE_URL=https://api.github.com
# Total budget for one GitHub request, in seconds. A user is waiting on
# a form submit while this runs, so keep it short.
GITHUB_REQUEST_TIMEOUT_SECONDS=5.0
# GitHub rejects API requests that send no User-Agent. Identifies the
# application, never a user, and carries no credential.
GITHUB_USER_AGENT=CareerLens/0.1 (+https://github.com/careerlens)

# --- Public GitHub ingestion (apps/api, Prompt 3.2) ---
# STILL NO CREDENTIAL. Ingestion reads the same unauthenticated public
# endpoints the connection flow does: no password, no OAuth token, no
# personal access token, no private repository.
#
# How many repositories one import fetches languages + README for. This
# is a hard budget, not a preference: unauthenticated GitHub allows 60
# requests/hour per IP and each repository costs two of them, so 20 is
# already ~70% of the hourly budget for one user. Every listed
# repository still gets its basic details (that data is in the listing
# and costs nothing extra); only the detail fetch is capped.
GITHUB_MAX_REPOSITORIES=20
# Pagination safety valve (pages of 100). Hitting it marks the listing
# incomplete, which suppresses deletion reconciliation.
GITHUB_MAX_REPOSITORY_PAGES=10
# README text is truncated to this many characters. The text has to be
# kept (Prompt 3.3 quotes it as evidence, and a hash cannot be quoted),
# but a README has no natural size bound.
GITHUB_README_MAX_CHARS=20000
# Retries for a transient ingestion failure (timeout, 5xx). Rate
# limiting is handled separately: it pauses and resumes from GitHub's
# own reset time without consuming these attempts.
GITHUB_INGESTION_MAX_RETRIES=2

# --- Embeddings (apps/api) ---
# THERE IS NO EMBEDDING CREDENTIAL IN THIS PRODUCT AND THERE IS NO
# VARIABLE NAME BELOW FOR ONE. The only provider that exists is a
# deterministic local mock: no API key is read or requested, and no
# embedding service is ever called. A real provider is a later slice.
#
# Which provider to build. "mock" is the only known value; an unknown
# name raises on startup of the code that uses it rather than silently
# falling back, so a typo cannot fill the table with fake vectors
# labelled as something else.
EMBEDDING_PROVIDER=mock
# The width of the vectors the PROVIDER produces. The COLUMN is fixed at
# 384 by its migration, and a write whose length differs fails loudly.
# Changing the stored width is a migration, not a config change.
EMBEDDING_DIMENSION=384
# Stored with every vector and part of the deduplication identity, so
# changing it means "re-embed under a new model" rather than "relabel
# the rows we already have". Named to be unmistakably a fake.
EMBEDDING_MODEL_IDENTIFIER=mock-deterministic-v1
# Set EMBEDDING_PROVIDER=local to use the real model below (Prompt
# 5.2b). It runs in-process via onnxruntime — STILL NO CREDENTIAL and no
# hosted API; the only network access is a one-time ~90 MB model-weight
# download on first use, cached on disk afterwards. 384 dimensions, so
# it needs no migration. Tests keep using the deterministic mock.
EMBEDDING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM explanations (apps/api, Prompt 6.1) ---
# THERE IS NO LLM CREDENTIAL IN THIS PRODUCT AND THERE IS NO VARIABLE
# NAME BELOW FOR ONE. The only provider that exists is a deterministic
# local mock: no API key is read or requested, and no model service is
# ever called. A real provider is a later slice, and it brings its own
# decisions about timeouts, retries, rate limits and where its key lives.
#
# The model only ever receives PERSISTED FACTS — score components,
# skill names, evidence ids and stored excerpts. It never receives a raw
# resume, a README, or a job description, and it can neither compute nor
# change a score: anything it returns that is not grounded in the facts
# it was given is rejected rather than shown.
EXPLANATION_PROVIDER=mock
# Hard budget for one provider call, in seconds (Prompt 6.2). Applied by
# the adapter rather than trusted to a provider's own client, so every
# provider has a deadline — a hung request in the API's request path is
# a stalled page and a held connection.
EXPLANATION_TIMEOUT_SECONDS=10.0
# Total provider calls, including the first. Only a timeout or an
# unavailable provider is retried; a response that arrived and failed
# validation never is. Worst-case wait is
# attempts x timeout + (attempts - 1) x backoff.
EXPLANATION_MAX_ATTEMPTS=2
# Fixed backoff between attempts, in seconds. Not exponential — with two
# attempts that would be decoration.
EXPLANATION_RETRY_BACKOFF_SECONDS=0.5

# --- Web (apps/web) ---
# Base URL the browser uses to reach the API.
# Next.js only reads this from apps/web/.env.local, not this root file —
# copy the line there too if you need a non-default value.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Read by scripts/smoke.sh to override the web app's port if 3000 is busy.
WEB_PORT=3000
